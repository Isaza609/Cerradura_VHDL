// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "04/06/2026 09:48:00"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    contador_intentos
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module contador_intentos_vlg_sample_tst(
	acceso_ok,
	Clock_intento,
	Reset,
	sampler_tx
);
input  acceso_ok;
input  Clock_intento;
input  Reset;
output sampler_tx;

reg sample;
time current_time;
always @(acceso_ok or Clock_intento or Reset)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module contador_intentos_vlg_check_tst (
	alarma,
	intentos,
	sampler_rx
);
input  alarma;
input [1:0] intentos;
input sampler_rx;

reg  alarma_expected;
reg [1:0] intentos_expected;

reg  alarma_prev;
reg [1:0] intentos_prev;

reg  alarma_expected_prev;
reg [1:0] intentos_expected_prev;

reg  last_alarma_exp;
reg [1:0] last_intentos_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:2] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 2'b1;
end

// update real /o prevs

always @(trigger)
begin
	alarma_prev = alarma;
	intentos_prev = intentos;
end

// update expected /o prevs

always @(trigger)
begin
	alarma_expected_prev = alarma_expected;
	intentos_expected_prev = intentos_expected;
end



// expected alarma
initial
begin
	alarma_expected = 1'bX;
end 
// expected intentos[ 1 ]
initial
begin
	intentos_expected[1] = 1'bX;
end 
// expected intentos[ 0 ]
initial
begin
	intentos_expected[0] = 1'bX;
end 
// generate trigger
always @(alarma_expected or alarma or intentos_expected or intentos)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected alarma = %b | expected intentos = %b | ",alarma_expected_prev,intentos_expected_prev);
	$display("| real alarma = %b | real intentos = %b | ",alarma_prev,intentos_prev);
`endif
	if (
		( alarma_expected_prev !== 1'bx ) && ( alarma_prev !== alarma_expected_prev )
		&& ((alarma_expected_prev !== last_alarma_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port alarma :: @time = %t",  $realtime);
		$display ("     Expected value = %b", alarma_expected_prev);
		$display ("     Real value = %b", alarma_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_alarma_exp = alarma_expected_prev;
	end
	if (
		( intentos_expected_prev[0] !== 1'bx ) && ( intentos_prev[0] !== intentos_expected_prev[0] )
		&& ((intentos_expected_prev[0] !== last_intentos_exp[0]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port intentos[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", intentos_expected_prev);
		$display ("     Real value = %b", intentos_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_intentos_exp[0] = intentos_expected_prev[0];
	end
	if (
		( intentos_expected_prev[1] !== 1'bx ) && ( intentos_prev[1] !== intentos_expected_prev[1] )
		&& ((intentos_expected_prev[1] !== last_intentos_exp[1]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port intentos[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", intentos_expected_prev);
		$display ("     Real value = %b", intentos_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_intentos_exp[1] = intentos_expected_prev[1];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#400000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module contador_intentos_vlg_vec_tst();
// constants                                           
// general purpose registers
reg acceso_ok;
reg Clock_intento;
reg Reset;
// wires                                               
wire alarma;
wire [1:0] intentos;

wire sampler;                             

// assign statements (if any)                          
contador_intentos i1 (
// port map - connection between master ports and signals/registers   
	.acceso_ok(acceso_ok),
	.alarma(alarma),
	.Clock_intento(Clock_intento),
	.intentos(intentos),
	.Reset(Reset)
);

// Clock_intento
initial
begin
	Clock_intento = 1'b0;
	Clock_intento = #80000 1'b1;
	Clock_intento = #20000 1'b0;
	Clock_intento = #60000 1'b1;
	Clock_intento = #20000 1'b0;
	Clock_intento = #60000 1'b1;
	Clock_intento = #20000 1'b0;
	Clock_intento = #60000 1'b1;
	Clock_intento = #20000 1'b0;
end 

// acceso_ok
initial
begin
	acceso_ok = 1'b0;
	acceso_ok = #300000 1'b1;
end 

// Reset
initial
begin
	Reset = 1'b0;
	Reset = #40000 1'b1;
end 

contador_intentos_vlg_sample_tst tb_sample (
	.acceso_ok(acceso_ok),
	.Clock_intento(Clock_intento),
	.Reset(Reset),
	.sampler_tx(sampler)
);

contador_intentos_vlg_check_tst tb_out(
	.alarma(alarma),
	.intentos(intentos),
	.sampler_rx(sampler)
);
endmodule

