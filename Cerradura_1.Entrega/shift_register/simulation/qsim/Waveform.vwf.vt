	Dout3_expected[1] = 1'bX;
end 
// expected Dout3[ 0 ]
initial
begin
	Dout3_expected[0] = 1'bX;
end 
// generate trigger
always @(Dout0_expected or Dout0 or Dout1_expected or Dout1 or Dout2_expected or Dout2 or Dout3_expected or Dout3)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected Dout0 = %b | expected Dout1 = %b | expected Dout2 = %b | expected Dout3 = %b | ",Dout0_expected_prev,Dout1_expected_prev,Dout2_expected_prev,Dout3_expected_prev);
	$display("| real Dout0 = %b | real Dout1 = %b | real Dout2 = %b | real Dout3 = %b | ",Dout0_prev,Dout1_prev,Dout2_prev,Dout3_prev);
`endif
	if (
		( Dout0_expected_prev[0] !== 1'bx ) && ( Dout0_prev[0] !== Dout0_expected_prev[0] )
		&& ((Dout0_expected_prev[0] !== last_Dout0_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Dout0[0] :: @time = %t",  $realtime);
