module shift_register_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Clock;
reg [3:0] Din;
reg Reset;
// wires                                               
wire [3:0] Dout0;
wire [3:0] Dout1;
wire [3:0] Dout2;
wire [3:0] Dout3;

wire sampler;                             

// assign statements (if any)                          
shift_register i1 (
// port map - connection between master ports and signals/registers   
	.Clock(Clock),
	.Din(Din),
	.Dout0(Dout0),
	.Dout1(Dout1),
	.Dout2(Dout2),
	.Dout3(Dout3),
	.Reset(Reset)
);

// Clock
always
begin
	Clock = 1'b0;
	Clock = #50000 1'b1;
	#50000;
end 
// Din[ 3 ]
initial
begin
	Din[3] = 1'b0;
end 
// Din[ 2 ]
initial
begin
	Din[2] = 1'b1;
	Din[2] = #100000 1'b0;
end 
// Din[ 1 ]
initial
begin
	Din[1] = 1'b1;
	Din[1] = #200000 1'b0;
	Din[1] = #100000 1'b1;
	Din[1] = #100000 1'b0;
end 
// Din[ 0 ]
initial
begin
	Din[0] = 1'b1;
	Din[0] = #200000 1'b0;
end 

// Reset
initial
begin
	Reset = 1'b1;
end 

shift_register_vlg_sample_tst tb_sample (
	.Clock(Clock),
	.Din(Din),
	.Reset(Reset),
	.sampler_tx(sampler)
);

shift_register_vlg_check_tst tb_out(
	.Dout0(Dout0),
	.Dout1(Dout1),
	.Dout2(Dout2),
	.Dout3(Dout3),
	.sampler_rx(sampler)
);
endmodule

