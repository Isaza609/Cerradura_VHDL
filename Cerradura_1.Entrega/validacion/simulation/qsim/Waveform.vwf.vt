// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "04/03/2026 23:50:58"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    validacion
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module validacion_vlg_sample_tst(
	clave_ingresada,
	count18O_val,
	sampler_tx
);
input [15:0] clave_ingresada;
input [7:0] count18O_val;
output sampler_tx;

reg sample;
time current_time;
always @(clave_ingresada or count18O_val)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module validacion_vlg_check_tst (
	acceso_ok,
	clave_ok,
	horario_ok,
	sampler_rx
);
input  acceso_ok;
input  clave_ok;
input  horario_ok;
input sampler_rx;

reg  acceso_ok_expected;
reg  clave_ok_expected;
reg  horario_ok_expected;

reg  acceso_ok_prev;
reg  clave_ok_prev;
reg  horario_ok_prev;

reg  acceso_ok_expected_prev;
reg  clave_ok_expected_prev;
reg  horario_ok_expected_prev;

reg  last_acceso_ok_exp;
reg  last_clave_ok_exp;
reg  last_horario_ok_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:3] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 3'b1;
end

// update real /o prevs

always @(trigger)
begin
	acceso_ok_prev = acceso_ok;
	clave_ok_prev = clave_ok;
	horario_ok_prev = horario_ok;
end

// update expected /o prevs

always @(trigger)
begin
	acceso_ok_expected_prev = acceso_ok_expected;
	clave_ok_expected_prev = clave_ok_expected;
	horario_ok_expected_prev = horario_ok_expected;
end



// expected acceso_ok
initial
begin
	acceso_ok_expected = 1'bX;
end 

// expected clave_ok
initial
begin
	clave_ok_expected = 1'bX;
end 

// expected horario_ok
initial
begin
	horario_ok_expected = 1'bX;
end 
// generate trigger
always @(acceso_ok_expected or acceso_ok or clave_ok_expected or clave_ok or horario_ok_expected or horario_ok)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected acceso_ok = %b | expected clave_ok = %b | expected horario_ok = %b | ",acceso_ok_expected_prev,clave_ok_expected_prev,horario_ok_expected_prev);
	$display("| real acceso_ok = %b | real clave_ok = %b | real horario_ok = %b | ",acceso_ok_prev,clave_ok_prev,horario_ok_prev);
`endif
	if (
		( acceso_ok_expected_prev !== 1'bx ) && ( acceso_ok_prev !== acceso_ok_expected_prev )
		&& ((acceso_ok_expected_prev !== last_acceso_ok_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port acceso_ok :: @time = %t",  $realtime);
		$display ("     Expected value = %b", acceso_ok_expected_prev);
		$display ("     Real value = %b", acceso_ok_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_acceso_ok_exp = acceso_ok_expected_prev;
	end
	if (
		( clave_ok_expected_prev !== 1'bx ) && ( clave_ok_prev !== clave_ok_expected_prev )
		&& ((clave_ok_expected_prev !== last_clave_ok_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port clave_ok :: @time = %t",  $realtime);
		$display ("     Expected value = %b", clave_ok_expected_prev);
		$display ("     Real value = %b", clave_ok_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_clave_ok_exp = clave_ok_expected_prev;
	end
	if (
		( horario_ok_expected_prev !== 1'bx ) && ( horario_ok_prev !== horario_ok_expected_prev )
		&& ((horario_ok_expected_prev !== last_horario_ok_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port horario_ok :: @time = %t",  $realtime);
		$display ("     Expected value = %b", horario_ok_expected_prev);
		$display ("     Real value = %b", horario_ok_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_horario_ok_exp = horario_ok_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#600000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

