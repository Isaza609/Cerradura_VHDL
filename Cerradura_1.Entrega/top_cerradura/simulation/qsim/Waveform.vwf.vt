initial 

begin 
$timeformat(-12,3," ps",6);
#700000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module top_cerradura_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Clock_count;
reg Clock_reg;
reg confirmar;
reg [3:0] Din;
reg Reset;
reg UP_DOWN;
// wires                                               
wire [0:6] Disp0;
wire [0:6] Disp1;
wire [0:6] Disp2;
wire [0:6] Disp3;
wire LED_acceso;
wire LED_alarma;
wire LED_clave;
wire LED_horario;
wire [1:0] LED_intentos;

wire sampler;                             

// assign statements (if any)                          
top_cerradura i1 (
// port map - connection between master ports and signals/registers   
	.Clock_count(Clock_count),
	.Clock_reg(Clock_reg),
	.confirmar(confirmar),
	.Din(Din),
	.Disp0(Disp0),
	.Disp1(Disp1),
	.Disp2(Disp2),
	.Disp3(Disp3),
	.LED_acceso(LED_acceso),
	.LED_alarma(LED_alarma),
	.LED_clave(LED_clave),
	.LED_horario(LED_horario),
	.LED_intentos(LED_intentos),
	.Reset(Reset),
	.UP_DOWN(UP_DOWN)
);

// Clock_count
initial
begin
	repeat(17)
	begin
		Clock_count = 1'b0;
		Clock_count = #20000 1'b1;
		# 20000;
	end
	Clock_count = 1'b0;
end 

// Clock_reg
initial
begin
	Clock_reg = 1'b0;
	Clock_reg = #80000 1'b1;
	Clock_reg = #20000 1'b0;
	Clock_reg = #40000 1'b1;
	Clock_reg = #20000 1'b0;
	Clock_reg = #40000 1'b1;
	Clock_reg = #20000 1'b0;
	Clock_reg = #40000 1'b1;
	Clock_reg = #20000 1'b0;
end 

// confirmar
initial
begin
	confirmar = 1'b0;
	confirmar = #320000 1'b1;
	confirmar = #20000 1'b0;
	confirmar = #60000 1'b1;
	confirmar = #20000 1'b0;
	confirmar = #80000 1'b1;
	confirmar = #20000 1'b0;
end 
// Din[ 3 ]
initial
begin
	Din[3] = 1'b0;
end 
// Din[ 2 ]
initial
begin
	Din[2] = 1'b0;
end 
// Din[ 1 ]
initial
begin
	Din[1] = 1'b0;
end 
// Din[ 0 ]
initial
begin
	Din[0] = 1'b0;
	Din[0] = #60000 1'b1;
	Din[0] = #100000 1'b0;
end 

// Reset
initial
begin
	Reset = 1'b0;
	Reset = #40000 1'b1;
end 

// UP_DOWN
initial
begin
	UP_DOWN = 1'b0;
end 

top_cerradura_vlg_sample_tst tb_sample (
	.Clock_count(Clock_count),
	.Clock_reg(Clock_reg),
	.confirmar(confirmar),
	.Din(Din),
	.Reset(Reset),
	.UP_DOWN(UP_DOWN),
	.sampler_tx(sampler)
);

top_cerradura_vlg_check_tst tb_out(
	.Disp0(Disp0),
	.Disp1(Disp1),
	.Disp2(Disp2),
	.Disp3(Disp3),
	.LED_acceso(LED_acceso),
	.LED_alarma(LED_alarma),
	.LED_clave(LED_clave),
	.LED_horario(LED_horario),
	.LED_intentos(LED_intentos),
	.sampler_rx(sampler)
);
endmodule

